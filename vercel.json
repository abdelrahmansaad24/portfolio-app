{
  "rewrites": [
    {
      "source": "/box-api/:path*",
      "destination": "https://api.box.com/:path*"
    },
    {
      "source": "/box-upload/:path*",
      "destination": "https://upload.box.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
